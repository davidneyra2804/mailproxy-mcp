# Optional proxy for the "tls" profile. By default the certificate is
# internal, so the stack does not request a public certificate at startup.
# For the real domain, remove the "tls internal" line and define
# MCP_PUBLIC_HOST with a name that resolves to this server (Caddy will use
# Let's Encrypt).
#
# MCP server only: the panel (8766) is not exposed here. It proxies the
# whole prefix, so /mcp, /mcp/<account> and /mcp/<domain> all work.

{$MCP_PUBLIC_HOST:localhost} {
	tls internal
	reverse_proxy mcp:8765
}
