# /etc/systemd/system/mailproxy-mcp.service
# The process listens on 127.0.0.1 only. nginx is what publishes HTTPS.
# The Portainer deployment is in docker-compose.yml and does not use this unit.

[Unit]
Description=Mail MCP server (IMAP reading and writing under confirmation)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mcpmail
Group=mcpmail
WorkingDirectory=/opt/mailproxy-mcp
EnvironmentFile=/etc/mailproxy-mcp/env
# --workers 1 is mandatory: the confirmation tokens and the daily send
# limit live in this process's memory. More workers would duplicate them.
ExecStart=/opt/mailproxy-mcp/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8765 --proxy-headers --forwarded-allow-ips=127.0.0.1 --workers 1
Restart=on-failure
RestartSec=5

# Hardening. If the interpreter dies with SIGSEGV at startup, check
# MemoryDenyWriteExecute (some CPython builds need it off).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
ReadWritePaths=/var/log/mcp-correo
# The panel and its database are mandatory: the database has to be
# writable. Put it in /var/lib/mcp-correo and add that path here:
# ReadWritePaths=/var/lib/mcp-correo
MemoryMax=512M

[Install]
WantedBy=multi-user.target
